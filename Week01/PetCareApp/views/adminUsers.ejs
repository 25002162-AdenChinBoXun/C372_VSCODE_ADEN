<!DOCTYPE html>
<html lang="en">
<head>
  <title>Admin - All Users & Pets</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body>

  <%- include ('partials/navbar') %>

  <div class="container mt-4">
    <h2>All Users and Their Pets</h2>
    <table class="table table-bordered">
      <thead>
        <tr>
          <th>User ID</th>
          <th>Name</th>
          <th>Username</th>
          <th>Role</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% for (let i = 0; i < users.length; i++) { %>
          <tr>
            <td><%= users[i].id %></td>
            <td><%= users[i].name %></td>
            <td><%= users[i].username %></td>
            <td><%= users[i].role %></td>
            <td>
                <a href="/admin/users/<%= users[i].id %>" class="btn btn-sm btn-dark">View</a>
                <a href="/admin/users/delete/<%= users[i].id %>" class="btn btn-sm btn-danger"
     onclick="return confirm('Are you sure you want to delete this user and all their pets and journals?');">Delete</a>
            </td>
          </tr>
        <% }; %>
      </tbody>
    </table>
    <a href="/journals" class="btn btn-secondary">Back to Journals</a>
  </div>
</body>
</html>
