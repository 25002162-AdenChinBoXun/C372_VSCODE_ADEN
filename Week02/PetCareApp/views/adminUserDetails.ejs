<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>User Details</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

  <%- include('partials/navbar') %>

  <div class="container mt-5">
    <h2 class="mb-4">User Details: <%= user.name %> (<%= user.username %>)</h2>

    <% if (pets.length === 0) { %>
      <p>This user has no pets registered.</p>
    <% } else { %>
      <% pets.forEach(pet => { %>
        <div class="card mb-4">
          <div class="card-header bg-dark text-white">
            Pet: <%= pet.name %>
          </div>
          <div class="card-body">
            <div class="row">
              <div class="col-md-3 text-center">
                <img src="/images/<%= pet.image %>" class="img-thumbnail" style="width: 200px; height: 200px; object-fit: cover;">
              </div>
              <div class="col-md-9">
                <p><strong>Species:</strong> <%= pet.species %></p>
                <p><strong>Breed:</strong> <%= pet.breed %></p>
                <p><strong>Age:</strong> <%= pet.age %> years</p>

                <% const petJournals = journals.filter(j => j.pet_id === pet.id); %>
                <% if (petJournals.length === 0) { %>
                  <p><em>No journal entries for this pet.</em></p>
                <% } else { %>
                  <h5>Journal Entries</h5>
                  <table class="table table-bordered table-sm">
                    <thead class="table-light">
                      <tr>
                        <th>#</th>
                        <th>Date</th>
                        <th>Activity</th>
                        <th>Notes</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% for (let i = 0; i < petJournals.length; i++) { %>
                        <tr>
                          <td><%= i + 1 %></td>
                          <td><%= petJournals[i].entry_date.toISOString().split('T')[0] %></td>
                          <td><%= petJournals[i].activity %></td>
                          <td><%= petJournals[i].notes %></td>
                        </tr>
                      <% } %>
                    </tbody>
                  </table>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
