<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Add New Pet</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container mt-5">
    <h2 class="mb-4">Add a New Pet</h2>
    <form action="/pets" method="POST" enctype="multipart/form-data">
      <div class="mb-3">
        <label class="form-label">Pet Name:</label>
        <input type="text" class="form-control" name="pet_name" required>
      </div>

      <div class="mb-3">
        <label class="form-label">Species:</label>
        <input type="text" class="form-control" name="species" required>
      </div>

      <div class="mb-3">
        <label class="form-label">Breed:</label>
        <input type="text" class="form-control" name="breed" required>
      </div>

      <div class="mb-3">
        <label class="form-label">Age:</label>
        <input type="number" class="form-control" name="age" min="0" required>
      </div>

      <div class="mb-3">
        <label class="form-label">Upload Pet Image:</label>
        <input type="file" class="form-control" name="pet_image" accept="image/*">
      </div>

      <button type="submit" class="btn btn-success">Add Pet</button>
    </form>
  </div>
</body>
</html>
