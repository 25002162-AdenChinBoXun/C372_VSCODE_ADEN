<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Pet Care Journal System</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  
    <%- include ('partials/navbar') %>

  <div class="container mt-5 text-center">
    <h1>Welcome to the Pet Care Journal System</h1>
    <p class="lead">Track your pets' activities and health in one place.</p>
    <% if (!session || !session.user) { %>
      <a href="/signup" class="btn btn-primary">Get Started</a>
    <% } else { %>
      <a href="/journals" class="btn btn-success">View My Journals</a>
    <% } %>
  </div>
</body>
</html>
